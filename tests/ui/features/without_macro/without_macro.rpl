pattern without-macro

patt {
    use std::vec::Vec;

    set_len_zero_only[
        $T: type,
    ] = fn _ (..) -> _ {
        let $vec: &mut Vec<$T> = _;
        'sink:
        _ = Vec::set_len(copy $vec, const 0usize);
        without!(_ = Vec::set_len(copy $vec, const 1usize));
    }
}

diag {
    set_len_zero_only = {
        primary(sink) = "`Vec::set_len(0)` without a following `set_len(1)`",
        label(sink)   = "`set_len(0)` called here",
        name          = "set_len_zero_only",
        level         = "deny",
    }
}
