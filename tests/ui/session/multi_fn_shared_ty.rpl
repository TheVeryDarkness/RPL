pattern multi-fn-shared-ty

patt {
    p[$T: type, $U: type] = {
        struct $Pair {
            $first: $T,
            $second: $U,
        }

        fn $f1(_: ()) {
        }

        fn $f2(_: ()) {
        }
    }
}

diag {
    p = {
        primary(f1, f2) = "multi-function pattern with shared type variables matched",
        note            = "struct and both functions were assigned in one MatchSession with shared type variables",
        name            = "multi_fn_shared_ty",
    }
}
